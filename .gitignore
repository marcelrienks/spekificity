# Spekificity — .gitignore

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
.vscode/
.idea/

# ── Obsidian app workspace state (regenerates on open) ───────
.obsidian/

# vault/graph/ is regeneratable — gitignore on large repos.
# Remove the next two lines to commit your graph (recommended for small projects).
vault/graph/graph.json
vault/graph/graph.html
# vault/graph/nodes/        ← uncomment to exclude all auto-generated node files (>500 nodes)

# ── Logs / temp ───────────────────────────────────────────────
*.log
*.bak

# ── Python (uv / tool envs) ──────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
.python-version

# ── Python build artifacts ────────────────────────────────────
*.egg-info/
dist/
build/
.pytest_cache/

# lat.md generated index within .spek (keep wiki/ human-readable)
.spek/lat.md/

# ── Framework / Config ────────────────────────────────────────
.specify/
.claude/

# ── spek init output dirs (agent integrations) ────────────────
.gemini/
.cursor/
.windsurf/
.cline/
.codex/
.kiro/
.amp/
.qwen/
.agents/

# Note: .github/ tracked for agent skill definitions and copilot instructions